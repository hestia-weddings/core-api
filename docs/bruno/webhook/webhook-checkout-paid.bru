meta {
  name: Webhook Asaas (CHECKOUT_PAID)
  type: http
  seq: 1
}

post {
  url: {{base-url}}/webhook/asaas/:webhookToken
  body: json
  auth: none
}

params:path {
  webhookToken: your-webhook-token-here
}

