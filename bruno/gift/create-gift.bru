meta {
  name: Create Gift
  type: http
  seq: 2
}

post {
  url: {{base-url}}/gift
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token-couple}}
}

body:json {
  {
    "description": "Kitchen Blender",
    "picture": "https://example.com/blender.jpg",
    "price": 15000,
    "stock": 1
  }
}
